# Copy values into your hosting provider's environment settings; do not commit a populated .env file.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
# Do not commit a populated .env file or real credentials.
AIVEN_HOST=your-mysql-host
AIVEN_PORT=3306
AIVEN_DATABASE=your-database
AIVEN_USER=your-database-user
AIVEN_PASSWORD=replace-with-secret

# Generate at least 32 random bytes (for example, 48+ random printable characters).
# The application uses the supplied string bytes directly; do not Base64-decode it.
JWT_SECRET=replace-with-a-long-random-secret

RAZORPAY_KEY_ID=replace-with-key-id
RAZORPAY_KEY_SECRET=replace-with-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Exact deployed frontend origin(s), comma-separated; no wildcard.
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example

# Optional one-time bootstrap account. Remove both values from the host after first-admin verification.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Private prescription storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=ydkweahp
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
